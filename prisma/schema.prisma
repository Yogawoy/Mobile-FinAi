generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (9)
// ==========================================

enum WalletType {
  CASH
  BANK
  EWALLET
  SAVINGS
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  SAFE
  CAUTION
  DANGER
  INSUFFICIENT_DATA
}

enum AnomalyType {
  OVER_BUDGET
  CATEGORY_SPIKE
  OUTLIER_TX
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  BUDGET_ALERT
  ANOMALY_ALERT
  RECURRING_REMINDER
  GOAL_MILESTONE
  SYSTEM
}

// ==========================================
// MODELS (13)
// ==========================================

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String   @map("password_hash")
  currency            String   @default("IDR")
  monthlyIncomeTarget Decimal? @map("monthly_income_target") @db.Decimal(15, 2)
  financialChallenge  String?  @map("financial_challenge")
  budgetRule          String?  @map("budget_rule")
  hasCompletedSetup   Boolean  @default(false) @map("has_completed_setup")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  wallets               Wallet[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  financialGoals        FinancialGoal[]
  cashflowForecasts     CashflowForecast[]
  spendingAnomalies     SpendingAnomaly[]
  aiInsights            AiInsight[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Wallet {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  name           String
  type           WalletType
  initialBalance Decimal    @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal    @default(0) @map("current_balance") @db.Decimal(15, 2)
  color          String
  accountNumber  String?    @map("account_number")
  isArchived     Boolean    @default(false) @map("is_archived")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions            Transaction[]          @relation("WalletTransactions")
  incomingTransfers       Transaction[]          @relation("DestinationWalletTransactions")
  recurringTransactions   RecurringTransaction[]

  @@index([userId])
  @@map("wallets")
}

model Category {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  name      String
  type      CategoryType
  icon      String
  color     String
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  spendingAnomalies     SpendingAnomaly[]

  @@unique([userId, name, type])
  @@map("categories")
}

model Transaction {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  walletId            String          @map("wallet_id")
  destinationWalletId String?         @map("destination_wallet_id")
  categoryId          String?         @map("category_id")
  recurringId         String?         @map("recurring_id")
  type                TransactionType
  amount              Decimal         @db.Decimal(15, 2)
  note                String?
  transactionDate     DateTime        @map("transaction_date")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet                @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Restrict)
  destinationWallet Wallet?               @relation("DestinationWalletTransactions", fields: [destinationWalletId], references: [id], onDelete: SetNull)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurring         RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  spendingAnomalies SpendingAnomaly[]

  @@index([userId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, walletId])
  @@map("transactions")
}

model RecurringTransaction {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  walletId    String             @map("wallet_id")
  categoryId  String?            @map("category_id")
  title       String
  type        TransactionType
  amount      Decimal            @db.Decimal(15, 2)
  frequency   RecurringFrequency
  nextRunDate DateTime           @map("next_run_date")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
}

enum BudgetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model Budget {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  categoryId        String       @map("category_id")
  month             Int
  year              Int
  period            BudgetPeriod @default(MONTHLY)
  limitAmount       Decimal      @map("limit_amount") @db.Decimal(15, 2)
  alertThresholdPct Int          @default(80) @map("alert_threshold_pct")
  resetAt           DateTime?    @map("reset_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

model FinancialGoal {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  name          String
  targetAmount  Decimal    @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @map("current_amount") @db.Decimal(15, 2)
  deadline      DateTime
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("financial_goals")
}

model CashflowForecast {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  month            Int
  year             Int
  totalIncomeMtd   Decimal   @map("total_income_mtd") @db.Decimal(15, 2)
  totalExpenseMtd  Decimal   @map("total_expense_mtd") @db.Decimal(15, 2)
  dailyBurnRate    Decimal   @map("daily_burn_rate") @db.Decimal(15, 2)
  projectedExpense Decimal   @map("projected_expense") @db.Decimal(15, 2)
  projectedBalance Decimal   @map("projected_balance") @db.Decimal(15, 2)
  riskLevel        RiskLevel @map("risk_level")
  calculatedAt     DateTime  @default(now()) @map("calculated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("cashflow_forecasts")
}

model SpendingAnomaly {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  categoryId    String?         @map("category_id")
  transactionId String?         @map("transaction_id")
  month         Int
  year          Int
  anomalyType   AnomalyType     @map("anomaly_type")
  severity      AnomalySeverity
  deviationPct  Decimal         @map("deviation_pct") @db.Decimal(8, 2)
  message       String
  isDismissed   Boolean         @default(false) @map("is_dismissed")
  detectedAt    DateTime        @default(now()) @map("detected_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, month, year])
  @@map("spending_anomalies")
}

model AiInsight {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  month             Int
  year              Int
  healthScore       Int      @map("health_score")
  statusLabel       String   @map("status_label")
  inputSnapshotJson Json     @map("input_snapshot_json")
  adviceJson        Json     @map("advice_json")
  modelUsed         String   @map("model_used")
  promptTokens      Int      @map("prompt_tokens")
  completionTokens  Int      @map("completion_tokens")
  generatedAt       DateTime @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("ai_insights")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadataJson Json?    @map("metadata_json")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
